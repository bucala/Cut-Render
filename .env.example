# Runtime configuration (Render dashboard, never commit actual values).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE
R2_ACCOUNT_ID=REPLACE
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
R2_BUCKET=cut-render-artwork
R2_PRIVATE_PREFIX=private
R2_PUBLIC_PREFIX=public
NODE_ENV=production
PORT=10000
STATIC_DIR=artifacts/cut-render/dist/public

# Public frontend build argument. Must match CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
# Leave empty with a standalone Clerk development instance.
VITE_CLERK_PROXY_URL=
